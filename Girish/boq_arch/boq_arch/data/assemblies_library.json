[
 {
  "id": "block-wall",
  "name": "Block wall (both faces plastered)",
  "measure": "length",
  "params": [
   {
    "name": "T",
    "label": "Wall thickness (mm)",
    "default": 200
   },
   {
    "name": "H",
    "label": "Wall height (m)",
    "default": 3.55
   }
  ],
  "outputs": [
   {
    "section": "D",
    "clause": "D2.1",
    "heads": [
     "Walls"
    ],
    "desc": "Concrete block, bedded and jointed in cement mortar complete in accordance with the Specifications and Drawings",
    "sub": "Block Walls",
    "item": "Walls, {T}mm thick",
    "formula": "L*H"
   },
   {
    "section": "J",
    "clause": "J3.1.2",
    "heads": [
     "Internal Finishes",
     "Finishing"
    ],
    "uhead": "Walls",
    "desc": "20mm thick cement mortar plaster complete in accordance with the Specifications and Drawings",
    "item": "To walls, as measured",
    "formula": "2*L*H"
   }
  ]
 },
 {
  "id": "block-wall-external",
  "name": "External block wall (inner face plastered)",
  "measure": "length",
  "params": [
   {
    "name": "T",
    "label": "Wall thickness (mm)",
    "default": 200
   },
   {
    "name": "H",
    "label": "Wall height (m)",
    "default": 3.55
   }
  ],
  "outputs": [
   {
    "section": "D",
    "clause": "D2.1",
    "heads": [
     "Walls"
    ],
    "desc": "Concrete block, bedded and jointed in cement mortar complete in accordance with the Specifications and Drawings",
    "sub": "Block Walls",
    "item": "Walls, {T}mm thick",
    "formula": "L*H"
   },
   {
    "section": "J",
    "clause": "J3.1.2",
    "heads": [
     "Internal Finishes",
     "Finishing"
    ],
    "uhead": "Walls",
    "desc": "20mm thick cement mortar plaster complete in accordance with the Specifications and Drawings",
    "item": "To walls, as measured",
    "formula": "L*H"
   }
  ]
 },
 {
  "id": "room-finishes",
  "name": "Room finishes (floor, skirting, walls, ceiling)",
  "measure": "area",
  "params": [
   {
    "name": "H",
    "label": "Floor to ceiling (m)",
    "default": 3.55
   },
   {
    "name": "D",
    "label": "Door widths to deduct from skirting (m)",
    "default": 0
   }
  ],
  "outputs": [
   {
    "section": "J",
    "clause": "J3.1.1",
    "heads": [
     "Internal Finishes",
     "Finishing"
    ],
    "uhead": "Floors",
    "desc": "Floor finish complete in accordance with the Specifications and Drawings",
    "item": "To floors, as measured",
    "formula": "A"
   },
   {
    "section": "J",
    "clause": "J3.2",
    "heads": [
     "Internal Finishes",
     "Finishing"
    ],
    "uhead": "Skirtings",
    "desc": "Skirting complete in accordance with the Specifications and Drawings",
    "item": "To walls, as measured",
    "formula": "max(P - D, 0)"
   },
   {
    "section": "J",
    "clause": "J3.1.2",
    "heads": [
     "Internal Finishes",
     "Finishing"
    ],
    "uhead": "Walls",
    "desc": "20mm thick cement mortar plaster complete in accordance with the Specifications and Drawings",
    "item": "To walls, as measured",
    "formula": "P*H"
   },
   {
    "section": "J",
    "clause": "J3.1.3",
    "heads": [
     "Internal Finishes",
     "Finishing"
    ],
    "uhead": "Ceilings",
    "desc": "Ceiling finish complete in accordance with the Specifications and Drawings",
    "item": "To ceilings, as measured",
    "formula": "A"
   }
  ]
 },
 {
  "id": "wet-area",
  "name": "Wet area floor (waterproofing + tiles, 300mm upturn)",
  "measure": "area",
  "params": [
   {
    "name": "U",
    "label": "Waterproofing upturn (m)",
    "default": 0.3
   }
  ],
  "outputs": [
   {
    "section": "G",
    "clause": "G2.1",
    "heads": [
     "Damp-proof Courses",
     "Superstructure Waterproofing System"
    ],
    "desc": "Superstructure waterproofing system including background complete in accordance with the Specifications and Drawings",
    "sub": "To Internal Wet Areas;",
    "item": "Horizontal surfaces",
    "formula": "A"
   },
   {
    "section": "G",
    "clause": "G2.1",
    "heads": [
     "Damp-proof Courses",
     "Superstructure Waterproofing System"
    ],
    "desc": "Superstructure waterproofing system including background complete in accordance with the Specifications and Drawings",
    "sub": "To Internal Wet Areas;",
    "item": "Vertical surfaces",
    "formula": "P*U"
   }
  ]
 },
