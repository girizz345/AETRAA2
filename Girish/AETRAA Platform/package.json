{
  "name": "aetraa-project-management-module",
  "version": "1.0.0",
  "description": "AETRAA \u2014 Project Management Module: post-contract construction management. Runs on Cloudflare (Worker + D1) or on any server with PostgreSQL (Oracle Cloud).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node server.js",
    "db:local": "wrangler d1 execute site-monitor --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute site-monitor --remote --file=./schema.sql",
    "build:app": "node tools/gen-app.mjs",
    "test": "node tools/run-tests.mjs",
    "demo": "node tools/demo.mjs",
    "build:demo": "node tools/build-demo.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "wrangler": "^4.131.1"
  },
  "private": true,
  "dependencies": {
    "fflate": "^0.8.3",
    "pg": "^8.23.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}